# Copy to .env for local (non-Docker) runs. Values here are for local development only.
PORT=3000
# Local dev DB: docker run -d --name weekendly-db -e POSTGRES_DB=weekendly -e POSTGRES_USER=weekendly -e POSTGRES_PASSWORD=weekendly -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://weekendly:weekendly@localhost:5433/weekendly
ADMIN_PASSWORD=weekendly-team
SESSION_SECRET=change-me-in-production
# "true" when served over HTTPS (session cookie becomes HTTPS-only)
COOKIE_SECURE=false
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
